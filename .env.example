# Copie este arquivo para .env e preencha os valores antes de rodar a aplicação
# cp .env.example .env

# Segredo para assinar os tokens JWT — troque por uma string longa e aleatória em produção
JWT_SECRET=troque-por-um-segredo-forte-em-producao

# Algoritmo de assinatura JWT (padrão: HS256)
JWT_ALGORITHM=HS256

# Tempo de expiração do token em minutos (padrão: 30)
TOKEN_EXPIRE_MINUTES=30
